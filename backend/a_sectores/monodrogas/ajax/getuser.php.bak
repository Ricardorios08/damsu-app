<?php
$q=$_GET["q"];

$con = mysql_connect('localhost', 'papo', 'papo2012');

 

if (!$con)
  {
  die('Could not connect: ' . mysql_error());
  }

mysql_select_db("oncologico", $con);

ECHO $sql="SELECT * FROM monodrogas WHERE nombre_comercial like '$q'";

$result = mysql_query($sql);

echo "<table border='1'>
<tr>
<th>Firstname</th>
<th>Lastname</th>
<th>Age</th>
<th>Hometown</th>
<th>Job</th>
</tr>";

while($row = mysql_fetch_array($result))
  {
  echo "<tr>";
  echo "<td>" . $row['troquel'] . "</td>";
  echo "<td>" . $row['nombre_comercial'] . "</td>";
  echo "<td>" . $row['presentacion'] . "</td>";
  echo "<td>" . $row['cod_barra'] . "</td>";
  echo "<td>" . $row['cod_droga'] . "</td>";
  echo "</tr>";
  }
echo "</table>";

mysql_close($con);
?> 